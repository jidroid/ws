.collage{margin:2rem 0}.collage-grid{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:4fr 5fr;grid-auto-flow:row;gap:3px;aspect-ratio:8/3}.collage-item{position:relative;display:block;overflow:hidden;border-radius:4px;border:1px solid var(--border);text-decoration:none;margin:0}.collage-item img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:none;border-radius:0;transition:transform .25s ease}.collage-item:hover img{transform:scale(1.03)}.collage-grid>:nth-child(1){grid-area:1/1/3/2}.collage-grid>:nth-child(2){grid-area:1/4/2/5}.collage-grid>:nth-child(3){grid-area:2/2/3/3}.collage-grid>:nth-child(4){grid-area:1/3/3/4}.collage-grid>:nth-child(5){grid-area:1/2/2/3}.collage-grid>:nth-child(6){grid-area:2/4/3/5}@media(max-width:768px){.collage-grid{grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(4,1fr);aspect-ratio:2/3}.collage-grid>:nth-child(1){grid-area:1/1/3/2}.collage-grid>:nth-child(4){grid-area:1/2/3/3}.collage-grid>:nth-child(2){grid-area:3/1/4/2}.collage-grid>:nth-child(5){grid-area:3/2/4/3}.collage-grid>:nth-child(3){grid-area:4/1/5/2}.collage-grid>:nth-child(6){grid-area:4/2/5/3}}